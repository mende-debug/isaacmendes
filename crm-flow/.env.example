# SQLite local (arquivo dentro de prisma/). Na Render use o disco: file:/var/data/crmflow.db
DATABASE_URL="file:./dev.db"
# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-longo"
# "true" libera a tela de cadastro de novos usuários
ALLOW_SIGNUP="true"
# Usuário criado pelo seed (npm run db:seed)
SEED_USERNAME="consultor"
SEED_PASSWORD="crmflow123"
